{
  "id": "rb-weak-hash",
  "title": "MD5 or SHA-1 in Ruby",
  "extensions": [
    ".rb"
  ],
  "pattern": "\\bDigest::(MD5|SHA1)\\b",
  "algorithm": {
    "groups": [
      1
    ],
    "map": {
      "md5": "MD5",
      "sha1": "SHA-1"
    }
  },
  "examples": {
    "match": [
      "digest = Digest::MD5.hexdigest(password)",
      "OpenSSL::Digest::SHA1.new # signature"
    ],
    "noMatch": [
      "digest = Digest::SHA256.hexdigest(data)"
    ]
  },
  "references": [
    "https://docs.ruby-lang.org/en/master/Digest.html"
  ],
  "author": "Hard Keel"
}
