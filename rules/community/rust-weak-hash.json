{
  "id": "rust-weak-hash",
  "title": "MD5 or SHA-1 hashing in Rust",
  "extensions": [
    ".rs"
  ],
  "pattern": "\\b(Md5|Sha1)::(?:new|digest)\\s*\\(|\\b(md5)::compute\\s*\\(",
  "algorithm": {
    "groups": [
      1,
      2
    ],
    "map": {
      "md5": "MD5",
      "sha1": "SHA-1"
    }
  },
  "examples": {
    "match": [
      "let mut h = Sha1::new(); // verifies the token",
      "let digest = md5::compute(password);"
    ],
    "noMatch": [
      "let mut h = Sha256::new();"
    ]
  },
  "references": [
    "https://docs.rs/sha1",
    "https://docs.rs/md5"
  ],
  "author": "Hard Keel"
}
