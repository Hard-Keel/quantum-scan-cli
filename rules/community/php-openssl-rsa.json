{
  "id": "php-openssl-rsa",
  "title": "RSA keys with PHP's OpenSSL extension",
  "extensions": [
    ".php"
  ],
  "pattern": "\\bOPENSSL_KEYTYPE_RSA\\b",
  "algorithm": "RSA",
  "keySize": "private_key_bits['\\\"]?\\s*=>\\s*(\\d{3,5})",
  "examples": {
    "match": [
      "$key = openssl_pkey_new(['private_key_type' => OPENSSL_KEYTYPE_RSA, 'private_key_bits' => 2048]);"
    ],
    "noMatch": [
      "$key = openssl_pkey_new(['private_key_type' => OPENSSL_KEYTYPE_EC]);"
    ]
  },
  "references": [
    "https://www.php.net/manual/en/function.openssl-pkey-new.php"
  ],
  "author": "Hard Keel"
}
