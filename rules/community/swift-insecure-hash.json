{
  "id": "swift-insecure-hash",
  "title": "MD5 or SHA-1 with CryptoKit",
  "extensions": [
    ".swift"
  ],
  "pattern": "\\bInsecure\\.(MD5|SHA1)\\b",
  "algorithm": {
    "groups": [
      1
    ],
    "map": {
      "md5": "MD5",
      "sha1": "SHA-1"
    }
  },
  "examples": {
    "match": [
      "let d = Insecure.MD5.hash(data: password)",
      "let d = Insecure.SHA1.hash(data: tokenData) // token"
    ],
    "noMatch": [
      "let d = SHA256.hash(data: data)"
    ]
  },
  "references": [
    "https://developer.apple.com/documentation/cryptokit/insecure"
  ],
  "author": "Hard Keel"
}
