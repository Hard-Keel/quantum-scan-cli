{
  "name": "@hardkeel/quantum-scan",
  "version": "0.2.0",
  "description": "Post-quantum readiness scanner: finds encryption quantum computers will break (RSA, ECC, DH), weak encryption, exposed infrastructure settings and leaked keys in code, config, websites and servers. Writes a CycloneDX CBOM, SARIF and a NIST migration plan.",
  "license": "Apache-2.0",
  "author": "Hard Keel (https://hardkeel.com)",
  "homepage": "https://hardkeel.com/quantum-scan/",
  "keywords": [
    "post-quantum",
    "post-quantum-cryptography",
    "pqc",
    "quantum-safe",
    "quantum-readiness",
    "ml-kem",
    "nist",
    "cbom",
    "cyclonedx",
    "cryptography",
    "encryption",
    "tls",
    "ssh",
    "security",
    "security-scanner",
    "scanner",
    "sast",
    "devsecops",
    "sarif",
    "secrets",
    "terraform",
    "kubernetes",
    "cloudformation",
    "github-action",
    "cli"
  ],
  "type": "module",
  "bin": {
    "quantum-scan": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "rules": "node scripts/build-rules.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hard-Keel/quantum-scan-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Hard-Keel/quantum-scan-cli/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
